{
  "name": "lensgate-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"@lensgate/*\" run build",
    "test": "pnpm --filter \"@lensgate/*\" run test",
    "demo": "node scripts/demo.mjs",
    "attach:antigravity": "node scripts/attach-antigravity.mjs",
    "detach:antigravity": "node scripts/detach-antigravity.mjs",
    "start": "pnpm --filter \"@lensgate/core\" run start",
    "dev": "pnpm --filter \"@lensgate/core\" run dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

